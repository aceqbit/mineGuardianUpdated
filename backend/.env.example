PORT=4000
NODE_ENV=development
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:4000
MONGODB_URI=
FIREBASE_PROJECT_ID=
# optional with STORAGE_DRIVER=local
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json
DEV_AUTH_BYPASS=false
DEMO_FAST_MODE=false
GEOFENCE_ENFORCE=false
SHIFT_WINDOW_ENFORCE=false
DEMO_ANCHOR_LAT=23.7460
DEMO_ANCHOR_LNG=86.4150
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
ML_MODE=hybrid
YOLO_PROVIDER=roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=personal-protective-equipment-combined-model/8
ONNX_MODEL_PATH=./models/ppe-yolov8n.onnx
ONNX_CLASSES=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DRY_RUN=true
# Every sign-up needs a verified email code (POST /api/auth/otp/*). Set false only for development.
OTP_REQUIRED=true
# Login/sign-up codes are emailed through Gmail SMTP (free): turn on 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords. Without these two the app cannot log anyone in.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# When TWILIO_DRY_RUN=false the server only dials/texts these E.164 numbers (comma separated). Never put a real emergency number here.
TWILIO_CALL_ALLOWLIST=
SLA_MINUTES=30
SLA_REMINDER_BASE_MINUTES=5
STORAGE_DRIVER=firebase
LOCAL_STORAGE_DIR=./storage-data
# ---- Add-on pack X (CLAUDE.md section 23), all optional ----
# Live tracking: miners' fused positions go to admins / own-zone supervisors every second.
TRACKING_ENABLED=true
TRACKING_STALE_SEC=30
TRACKING_OFFLINE_SEC=120
# OpenRouteService key for the surface leg (exit -> assembly point) only. Never used underground.
ORS_API_KEY=
# say = Gemini-written briefing spoken by Twilio (no tunnel needed); relay = live AI conversation (Twilio ConversationRelay,
# needs PUBLIC_BASE_URL on https and the `ws` endpoint reachable from Twilio).
VOICE_AGENT_MODE=say
VOICE_AGENT_MAX_SEC=180
# Daily safety feed (Gemini + Google Search grounding). Cron is Asia/Kolkata.
SAFETY_FEED_ENABLED=true
SAFETY_FEED_CRON=0 5,11,17 * * *
# storyboard = free in-app animated explainers; veo = paid AI video clip per day (set VEO_MODEL, unverified id); off
SAFETY_VIDEO_MODE=storyboard
VEO_MODEL=
SAFETY_SOURCE_ALLOWLIST=dgms.gov.in,ilo.org,osha.gov,msha.gov,hse.gov.uk
